rules_version = '2';

// Reglas de seguridad para Firestore — INAS Matrículas 2027
// Todas las escrituras de `preinscripciones_2027` entran exclusivamente desde el servidor
// de Vercel (`/api/admisiones`) autenticado con Firebase Admin SDK, impidiendo lecturas
// públicas o spam directo desde navegadores externos.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

