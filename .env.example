# ==============================================================================
# VARIABLES DE ENTORNO PARA VERCEL (Settings -> Environment Variables)
# Nunca subas tus claves reales a GitHub; configúralas en el panel de Vercel.
# ==============================================================================

# 1. Clave de IA para el Asistente Virtual (/api/chat)
# Usa DEEPSEEK_API_KEY (prioritaria si está definida) o GEMINI_API_KEY como alternativa:
DEEPSEEK_API_KEY=sk-tu_clave_de_deepseek_aqui
# GEMINI_API_KEY=tu_clave_de_gemini_opcional

# 2. Credenciales de Firebase Admin para guardar pre-inscripciones en Firestore (/api/admisiones)
# En Firebase Console -> Configuración del proyecto -> Cuentas de servicio -> "Generar nueva clave privada"
# Pega el contenido completo del archivo .json descargado en una sola variable:
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"tu-proyecto-inas","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@tu-proyecto-inas.iam.gserviceaccount.com"}
